{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/phase-dependency-package-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/password-response-guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/solution-structure-reference-lint.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/compose-healthcheck-lint.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/service-db-isolation-check.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
