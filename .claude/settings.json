{
  "permissions": {
    "allow": [
      "Bash(dotnet ef *)",
      "Bash(ASPNETCORE_ENVIRONMENT=Development ConnectionStrings__IdentityDb='Server=localhost,15544;Database=IdentityDb;User Id=sa;Password=Ar1sTest!Pass2026;TrustServerCertificate=True;' dotnet run --launch-profile http)",
      "Bash(disown)",
      "Bash(npm start *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/phase-dependency-package-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/password-response-guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/solution-structure-reference-lint.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/compose-healthcheck-lint.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/service-db-isolation-check.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
