# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Required. SQL Server "sa" password used by both the sqlserver container and identity-service's
# connection string. Must satisfy SQL Server's complexity policy (upper+lower+digit+symbol, 8+ chars).
SQLSERVER_SA_PASSWORD=

# Optional. PEM-encoded RSA private key identity-service signs access tokens with. Leave blank in
# local dev — ArisSigningKeyProvider falls back to an ephemeral Development-only key (regenerated,
# and any previously-issued tokens invalidated, on every container restart). Required outside
# Development (Technical Documentation §5.1) — never commit a real value here.
JWT_SIGNING_KEY=
